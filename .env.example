GEMINI_API_KEY=

# For CLI --sync (env var fallback when no per-user credentials are stored)
PAPRIKA_EMAIL=
PAPRIKA_PASSWORD=

# Google OAuth2 (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourapp.railway.app/api/auth/callback

# PostgreSQL (Railway add-on auto-injects DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fernet key for encrypting Paprika passwords at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated list of Google account emails allowed to sign in
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

# Base URL of the frontend (used for OAuth redirect after login)
FRONTEND_URL=https://yourapp.railway.app

# Production deployment
DOMAIN=recipes.example.com
